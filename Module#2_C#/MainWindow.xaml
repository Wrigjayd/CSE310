<Window x:Class="DndItemGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D&amp;D Random Item Generator"
        Height="850"
        Width="1200"
        MinHeight="700"
        MinWidth="1000"
        Loaded="Window_Loaded"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource MainTextBrush}">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBlock Text="Rarity:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox x:Name="RarityComboBox"
                      Width="140"
                      Margin="0,0,20,0"/>

            <TextBlock Text="Type:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox x:Name="TypeComboBox"
                      Width="220"
                      Margin="0,0,20,0"/>

            <TextBlock Text="Source:"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox x:Name="SourceComboBox"
                      Width="150"
                      Margin="0,0,20,0"/>

            <Button Content="Generate Table"
                    Padding="15,5"
                    Margin="0,0,10,0"
                    Click="GenerateTable_Click"/>

            <Button Content="Randomize Table"
                    Padding="15,5"
                    Click="RandomizeTable_Click"/>

        </StackPanel>

        <!-- Dice information -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock x:Name="ItemCountText"
                       FontWeight="Bold"
                       FontSize="14"
                       Margin="0,0,0,5"/>

            <TextBlock x:Name="RequiredDiceText"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <TextBlock x:Name="RollHelpText"
                       TextWrapping="Wrap"/>

        </StackPanel>

        <!-- Generated roll table -->
        <DataGrid Grid.Row="2"
                  x:Name="TableGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Roll"
                                    Width="70"
                                    Binding="{Binding RollNumber}"/>

                <DataGridTextColumn Header="Name"
                                    Width="*"
                                    Binding="{Binding Item.Name}"/>

                <DataGridTextColumn Header="Rarity"
                                    Width="110"
                                    Binding="{Binding Item.Rarity}"/>

                <DataGridTextColumn Header="Type"
                                    Width="200"
                                    Binding="{Binding Item.Type}"/>

                <DataGridTextColumn Header="Source"
                                    Width="100"
                                    Binding="{Binding Item.Source}"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Physical dice roll -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,15,0,10">

            <TextBlock Text="Physical Roll:"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0,0,10,0"/>

            <TextBox x:Name="PhysicalRollTextBox"
                     Width="180"
                     Height="28"
                     Margin="0,0,10,0"/>

            <Button Content="Submit Physical Roll"
                    Padding="15,5"
                    Click="PhysicalRoll_Click"/>

        </StackPanel>

        <!-- Digital dice -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <Button Content="Roll Digital Dice"
                    Padding="15,5"
                    Margin="0,0,15,0"
                    Click="DigitalRoll_Click"/>

            <TextBlock x:Name="DigitalRollText"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

        </StackPanel>

        <!-- Item result area -->
        <Grid Grid.Row="5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Item details -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource GoldBorderBrush}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,15,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock x:Name="ResultNameText"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="ResultDetailsText"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- Description -->
            <GroupBox Grid.Column="1"
                      Header="Description">

                <TextBox x:Name="DescriptionTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AcceptsReturn="True"
                         Padding="10"/>

            </GroupBox>

        </Grid>

    </Grid>

</Window>